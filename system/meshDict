// Local refinement
localRefinement
{
    // Refinement around car body
    "car_body"
    {
        cellSize 0.01;
	refinementThickness 0.05;
    }

    // Refinement around wheels
    "Wheel.*"
    {
        cellSize 0.01;
    }

    // Wake region refinement box
//    wake
//    {
//        cellSize 0.1;
//    }

    // Explicitly disable refinement at box boundaries
//    xMin { cellSize 0.5; }
//    xMax { cellSize 0.5; }
//    yMin { cellSize 0.5; }
//   yMax { cellSize 0.5; }
//    zMin { cellSize 0.5; }
//    zMax { cellSize 0.5; }
}

keepCellsIntersectingBoundary 0;

// Refinement boxes for wake and other regions
objectRefinements
{
    Box2
    {
        type box;
        cellSize 0.4;
        centre (10 0 1.5);
        lengthX 50;
        lengthY 10;
        lengthZ 8;
    }
    // Wake region behind car
    Box1
    {
        type box;
        cellSize 0.2;
        centre (10 0 1.5);
        lengthX 40;
        lengthY 8;
        lengthZ 5;
    }
    wakeBox
    {
        type box;
        cellSize 0.1;
        centre (3 0 1.5);
        lengthX 20;
        lengthY 5;
        lengthZ 3;
    }
    // Underbody refinement
    underbody
    {
        type box;
        cellSize 0.05;
        centre (0 0 0.75);
        lengthX 10;
        lengthY 3;
        lengthZ 1.5;
    }
}

// Rename boundary patches for the bounding box
renameBoundary
{
    newPatchNames
    {
        "xMin"
        {
            newName inlet;
            type    patch;
        }

        "xMax"
        {
            newName outlet;
            type    patch;
        }

        "yMin"
        {
            newName side1;
            type    symmetryPlane;  // or wall
        }

        "yMax"
        {
            newName side2;
            type    wall;  // or wall
        }

        "zMin"
        {
            newName ground;
            type    wall;
        }

        "zMax"
        {
            newName top;
            type    patch;
        }
    }
}

