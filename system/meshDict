// Rename boundary patches for the bounding box
renameBoundary
{
    newPatchNames
    {
        "xMin"
        {
            newName inlet;
            type    patch;
        }

        "xMax"
        {
            newName outlet;
            type    patch;
        }

        "yMin"
        {
            newName wall;
            type    wall;  // or wall
        }

        "yMax"
        {
            newName wall;
            type    wall;  // or wall
        }

        "zMin"
        {
            newName symmetry;
            type    symmetry;
        }

        "zMax"
        {
            newName symmetry;
            type    symmetry;
        }
    }
}

