FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      meshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Main surface file (or you can merge them)
surfaceFile "constant/triSurface/combined.stl";  // We'll create this

// Base mesh cell size
maxCellSize 0.5;  // Coarse far-field mesh

// Boundary layer settings
//boundaryCellSize 0.5;  // Cell size at surfaces

// Boundary layers
boundaryLayers
{
    patchBoundaryLayers
    {
        // Body boundary layer
        "body"
        {
            nLayers           2;
            thicknessRatio    1.3;
            maxFirstLayerThickness 0.005;
            allowDiscontinuity 0;
        }

	"optSurface"
        {
            nLayers           2;
            thicknessRatio    1.3;
            maxFirstLayerThickness 0.005;
            allowDiscontinuity 0;
        }


        // Wheels boundary lay//        "Wheel.*"
//        {
//            nLayers           4;
//            thicknessRatio    1.3;
//            maxFirstLayerThickness 0.003;
//            allowDiscontinuity 0;
//        }
    }

    optimiseLayer 1;
}

// Local refinement
localRefinement
{
    // Refinement around car body
    "body"
    {
        cellSize 0.04;
	refinementThickness 0.05;
    }
    
    "optSurface"
    {
        cellSize 0.04;
	refinementThickness 0.05;
	
    }

    // Refinement around wheels
    "wheel.*"
    {
        cellSize 0.02;
        
    }

    // Wake region refinement box
//    wake
//    {
//        cellSize 0.1;
//    }

    // Explicitly disable refinement at box boundaries
//    xMin { cellSize 0.5; }
//    xMax { cellSize 0.5; }
//    yMin { cellSize 0.5; }
//   yMax { cellSize 0.5; }
//    zMin { cellSize 0.5; }
//    zMax { cellSize 0.5; }
}

