keepCellsIntersectingBoundary 0;

// Refinement boxes for wake and other regions
objectRefinements
{
    Box2
    {
        type box;
        cellSize 0.4;
        centre (28 0 0);
        lengthX 8;
        lengthY 5;
        lengthZ 5;
    }
    // Wake region behind car
    Box1
    {
        type box;
        cellSize 0.2;
        centre (28 0 0);
        lengthX 6;
        lengthY 4;
        lengthZ 4;
    }
    wakeBox
    {
        type box;
        cellSize 0.1;
        centre (28 0 0);
        lengthX 5.5;
        lengthY 3.5;
        lengthZ 3.5;
    }
    // Underbody refinement
    underbody
    {
        type box;
        cellSize 0.02;
        centre (27.5 0 0);
        lengthX 5;
        lengthY 0.3;
        lengthZ 2;
    }
    
