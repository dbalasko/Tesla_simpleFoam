FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains     8;

method                 hierarchical;

kahipCoeffs 
{ 
    config                  fast;
    imbalance              0.01;
} 

simpleCoeffs 
{ 
    n                  (2 2 2);
    delta              0.001;
} 


hierarchicalCoeffs 
{ 
    n                  (2 2 2);
    delta              0.001;
    order	       xyz;
} 

distributed            false;

roots();

