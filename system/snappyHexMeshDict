FoamFile
{
    version	2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    body.stl
    {
        type triSurfaceMesh;
	name body;
    }
    
    optSurface.stl
    {
        type triSurfaceMesh;
	name optSurface;
    }
    
    wheelFL.stl
    {
        type triSurfaceMesh;
	name wheelFL;
    }
    
    wheelRL.stl
    {
        type triSurfaceMesh;
	name wheelRL;
    }
    
    box1
    {
    	type searchableBox;
        min (17.5 0 0);
        max (60 5 4);
   }
   
    box2
    {
    	type searchableBox;
        min (21 0 0);
        max (45 3.5 3);
   }
   
    box3
    {
    	type searchableBox;
        min (24 0 0);
        max (36 2.5 2);
   }
};

castellatedMeshControls
{
    maxLocalCells 2000000;
    maxGlobalCells 5000000;
    minRefinementCells 10;
    nCellsBetweenLevels 2;
    
    features
    (
    );

    refinementSurfaces
    {
        body
        {
            level (4 4);
        }
        
	optSurface
        {
            level (4 4);
        }
        
	wheelFL
        {
            level (4 4);
        }
        
	wheelRL
        {
            level (4 4);
        }
    }

    refinementRegions
    {
       box1
       {
             mode inside;
             levels ((1 1));
       }
       
       box2
       {
             mode inside;
             levels ((2 2));
       }

       box3
       {
             mode inside;
             levels ((3 3));
       }
    }

    locationInMesh	(1e-5 1e-5 1e-5);
    
    allowFreeStandingZoneFaces true;
}

snapControls
{

    nSmoothPatch 3;
    tolerance 0.1;
    nSolveIter 10;
    nRelaxIter 3;
}

addLayersControls
{
    relativeSizes true;
    layers
    {
        body
        {
            nSurfaceLayers 5;
        }
        
        optSurface
        {
            nSurfaceLayers 5;
        }
        
        wheelFL
        {
            nSurfaceLayers 5;
        }
        
        wheelRL
        {
            nSurfaceLayers 5;
        }
    }

    expansionRatio 1.2;
    finalLayerThickness 0.5;
    minThickness 0.05;
    nGrow 0;

    // Advanced settings
    featureAngle 60;
    nRelaxIter 10;
    nSmoothSurfaceNormals 20;
    nSmoothNormals 10;
    nSmoothThickness 10;
    maxFaceThicknessRatio 1;
    maxThicknessToMedialRatio 1;
    minMedianAxisAngle 130;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho 60;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minFlatness 0.5;
    minVol 1e-13;
    minTetQuality 1e-30;
    minArea -1;
    minTwist 0.05;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;


    // Advanced

    nSmoothScale 4;
    errorReduction 0.75;
}

debug 0;

mergeTolerance 1e-6;

// ************************************************************************* //
